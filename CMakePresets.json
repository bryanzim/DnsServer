{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026",
      "description": "Visual Studio 2026 (MSVC toolset) solution that builds the DNS server.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026",
      "cacheVariables": {
        "DNS_TOOLCHAIN": "vs2026",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "clang",
      "displayName": "Clang",
      "description": "Ninja build using Clang. On Windows this is clang-cl.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang.cmake",
      "cacheVariables": {
        "DNS_TOOLCHAIN": "clang",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "clang",
      "displayName": "Clang Debug",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "clang",
      "configurePreset": "clang",
      "configuration": "Release"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "vs2026",
      "steps": [
        { "type": "configure", "name": "vs2026" },
        { "type": "build", "name": "vs2026-release" }
      ]
    },
    {
      "name": "clang",
      "steps": [
        { "type": "configure", "name": "clang" },
        { "type": "build", "name": "clang" }
      ]
    }
  ]
}
